<idea-plugin>
    <id>ai.opencode.ide.jetbrains</id>
    <name>OpenCode UI</name>
    <version>2.0.0</version>
    <vendor url="https://opencode.ai">OpenCode</vendor>

    <description><![CDATA[
      <p>OpenCode UI - AI Coding Agent for JetBrains IDEs.</p>
      <p>Integrates the IDE with the OpenCode 2.x background service:</p>
      <ul>
        <li>Click the <b>OpenCode</b> icon (or <code>Ctrl+\</code>) to open a
            dedicated <b>OpenCode panel</b> on the right side hosting the OpenCode
            TUI — the code editor stays visible next to the agent
            ("file tree | code | agent" layout).</li>
        <li>The TUI connects to the running OpenCode 2.x background service
            (reads <code>service.json</code>) — no separate server spawn, so no
            more "server dead" restarts.</li>
        <li>Send files / selections to the agent with <code>Ctrl+Alt+K</code>.</li>
        <li>Clickable <code>@path</code> links in the terminal.</li>
        <li>Native multi-file diff viewer with Accept / Reject when a turn ends.</li>
      </ul>
    ]]></description>

    <change-notes><![CDATA[
      <p>2.0.0 - Rewritten for the OpenCode 2.x background service
      (<code>/api/*</code> HTTP surface + Basic Auth, auto-reconnect).
      OpenCode TUI now lives in a docked side panel so you can read the code
      while the agent works.</p>
    ]]></change-notes>

    <idea-version since-build="242"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="ai.opencode.ide.jetbrains.service.OpenCodeService"/>
        <projectService serviceImplementation="ai.opencode.ide.jetbrains.session.SessionManager"/>
        <projectService serviceImplementation="ai.opencode.ide.jetbrains.diff.DiffHandler"/>

        <toolWindow id="OpenCode"
                    anchor="right"
                    icon="/icons/opencode.svg"
                    factoryClass="ai.opencode.ide.jetbrains.ui.OpenCodeToolWindowFactory"/>

        <notificationGroup id="OpenCode" displayType="BALLOON"/>

        <statusBarWidgetFactory id="OpenCodeStatusBar"
                                implementation="ai.opencode.ide.jetbrains.ui.OpenCodeStatusBarWidgetFactory"/>

        <postStartupActivity implementation="ai.opencode.ide.jetbrains.ui.OpenCodeStartupActivity"/>

        <projectConfigurable instance="ai.opencode.ide.jetbrains.ui.OpenCodeSettingsConfigurable"
                            displayName="OpenCode"
                            id="ai.opencode.ide.jetbrains.settings"
                            parentId="tools"/>
    </extensions>

    <actions>
        <action id="OpenCode.QuickLaunch"
                class="ai.opencode.ide.jetbrains.actions.QuickLaunchAction"
                text="Open OpenCode"
                description="Open or focus the OpenCode terminal"
                icon="/icons/opencode.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="control BACK_SLASH"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta ESCAPE"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta ESCAPE"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="OpenCode.AddLines"
                class="ai.opencode.ide.jetbrains.actions.SendSelectionToTerminalAction"
                text="Add lines to OpenCode Terminal"
                icon="/icons/opencode.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
        </action>

        <action id="OpenCode.AddFile"
                class="ai.opencode.ide.jetbrains.actions.SendSelectionToTerminalAction"
                text="Add to OpenCode Terminal"
                icon="/icons/opencode.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt K"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="alt meta K"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="alt meta K"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>
        </action>

        <action id="OpenCode.NewSession"
                class="ai.opencode.ide.jetbrains.actions.NewSessionAction"
                text="OpenCode: New Session"
                description="Start a fresh OpenCode session">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="OpenCode.Interrupt"
                class="ai.opencode.ide.jetbrains.actions.InterruptAction"
                text="OpenCode: Stop"
                description="Interrupt the current OpenCode generation"/>

        <action id="OpenCode.OpenDiffs"
                class="ai.opencode.ide.jetbrains.actions.OpenDiffsAction"
                text="OpenCode: Review Diffs"
                description="Show the diff of the last OpenCode turn">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>